MOCK=1
MCP_TRANSPORT_TYPE=stdio
# Local stdio identity; demo keys work only in MOCK=1.
MCP_API_KEY=demo-readonly
# Production credentials (generate unique random values). Names referenced by config/roles.json.
READONLY_API_KEY=
REVIEWER_API_KEY=
DOCS_BOT_API_KEY=
# Optional HS256 JWT: iss=aud=pr-archaeologist, sub, role, exp; >=32 character secret.
JWT_SECRET=
# Needed only for MOCK=0; never forwarded to tools or clients.
GITHUB_TOKEN=
